FROM rayproject/ray:2.55.1-py312

WORKDIR /app


USER root
# git: huri-core is installed from its repository (see below).
RUN apt-get update && apt-get install -y \
build-essential \
git \
&& rm -rf /var/lib/apt/lists/*

USER ray

# constraints.txt pins protobuf==4.25.8 so serve_requirements.txt's deps can't
# bump protobuf past 4.x (breaks Ray Serve's _proto_to_dict). See the file.
COPY constraints.txt /app
COPY serve_requirements.txt /app
RUN pip install --no-cache-dir -c /app/constraints.txt -r serve_requirements.txt

# HuRI itself: huri-core, from its repository at HURI_CORE_REF (a git ref of
# https://github.com/Lucy-Robotics/huri-core; empty = the HURI_CORE_REF file of
# this repository), + the curated events and modules (packages/), as installed
# distributions — that is how the server finds them (entry points). Built from
# a copy the build user owns, since pip builds local projects in place; the
# script fails the build if modules and events do not fit together.
#   docker build --build-arg HURI_CORE_REF="$(cat HURI_CORE_REF)" ...
# A branch name (dev) is cached with this layer: pass its commit instead, or
# build with --no-cache (README.md, "Docker images").
ARG HURI_CORE_REF=""
COPY --chown=ray HURI_CORE_REF /tmp/huri-src/
COPY --chown=ray packages /tmp/huri-src/packages
COPY --chown=ray deploy/install_huri.sh /tmp/huri-src/
RUN sh /tmp/huri-src/install_huri.sh /tmp/huri-src "$HURI_CORE_REF" && rm -rf /tmp/huri-src
